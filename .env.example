# ---------------------------------------------------------------------------
# There are no required environment variables.
#
# The site builds, deploys and runs every route with this file empty. That is
# deliberate and it is worth stating: the Grounded evaluator is fully
# deterministic, so it runs in the visitor's browser with no server, no API
# key, no rate limit and no cost. The brief's `/api/grounded/evaluate` route
# handler was cut because there is nothing for it to do — a rules engine does
# not need a backend, and a demo that needs setup gets no engagement from a
# reviewer with four minutes.
# ---------------------------------------------------------------------------

# Canonical production origin. Used for absolute URLs in metadata, sitemap,
# robots.txt and Open Graph tags. Vercel sets VERCEL_PROJECT_PRODUCTION_URL
# automatically, so this is only needed once a custom domain is attached.
# Example: https://aniketagarwal.com
# Required: no
NEXT_PUBLIC_SITE_URL=

# Set to "true" to emit the bundle-analyzer report during a build.
# Used by `npm run analyze`. Never set in production.
# Required: no
ANALYZE=
