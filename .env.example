# ---------------------------------------------------------------------------
# All variables below are OPTIONAL. The site builds, deploys and runs every
# route without any of them set. They exist only to enable the Grounded demo's
# bring-your-own-text path; the bundled sample run is pre-computed static JSON
# and needs no key, no network and no configuration.
# ---------------------------------------------------------------------------

# Anthropic API key. Enables the LLM-as-judge dimension of the Grounded
# evaluator when a visitor submits their OWN summary text. Without it, the
# route handler runs the deterministic checks only and says so in the response.
# Obtain at: https://console.anthropic.com/settings/keys
# Required: no
ANTHROPIC_API_KEY=

# Canonical production origin, used for absolute URLs in metadata, sitemap,
# robots.txt and OG image tags. Vercel sets VERCEL_PROJECT_PRODUCTION_URL
# automatically, so this is only needed for a custom domain.
# Example: https://aniketagarwal.com
# Required: no
NEXT_PUBLIC_SITE_URL=

# Set to "true" to emit the webpack bundle-analyzer report during a build.
# Used by `npm run analyze`. Never set in production.
# Required: no
ANALYZE=
