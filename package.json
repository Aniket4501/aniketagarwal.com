{
  "name": "aniket-agarwal-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Product portfolio for Aniket Agarwal — Next.js App Router, statically generated.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/validate-content.ts",
    "check:budget": "tsx scripts/check-budget.ts",
    "check:truth": "tsx scripts/check-truth.ts",
    "capture": "tsx scripts/capture.ts",
    "check:a11y": "tsx scripts/check-a11y.ts",
    "lighthouse": "tsx scripts/lighthouse.mts",
    "analyze": "ANALYZE=true next build",
    "verify": "npm run typecheck && npm run lint && npm run check:truth && npm run check:content && npm run build && npm run check:budget"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "16.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "gray-matter": "4.0.3",
    "lighthouse": "^13.4.1",
    "next-mdx-remote": "6.0.0",
    "playwright": "^1.62.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
